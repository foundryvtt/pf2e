        {
            "_id": "2WswIWpzA6sC7prS",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Starlight Dependent",
            "sort": 300000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p>An asterid is mystically bonded to a single remote location with a good view of the open sky at night, most often a remote island, mountaintop, or open field. If they aren't in that location to see the sky at night on any given day, they become @UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 1}, increasing the value by 1 for each night they miss, with the drained value increasing at sunrise each day. The drained value reduces by 1 only when they see the stars again. The asterid can perform a 24-hour ritual to bond to a new location.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": []
                }
            },
            "type": "action"
        },
        {
