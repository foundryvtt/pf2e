        {
            "_id": "OibEBgwOtb96va5d",
            "img": "systems/pf2e/icons/actions/OneAction.webp",
            "name": "Bag Prey",
            "sort": 1000000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The bagman has a Medium or smaller creature @UUID[Compendium.pf2e.conditionitems.Item.Grabbed] or @UUID[Compendium.pf2e.conditionitems.Item.Restrained], is holding their bagman's sack, and their sack isn't full</p><hr /><p><strong>Effect</strong> The bagman stuffs the creature into their sack. While stuffed in the sack, a creature is restrained and @UUID[Compendium.pf2e.conditionitems.Item.Slowed]{Slowed 1}. If the creature [[/act escape dc=21]]{Escapes} or the sack becomes broken, the creature is ejected from the sack's mouth into a random space adjacent to the bagman.</p>"
                },
