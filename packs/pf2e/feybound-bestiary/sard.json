        {
            "_id": "T6Fo7xK3QCGTOIjY",
            "img": "systems/pf2e/icons/spells/chain-lightning.webp",
            "name": "Chain Lightning",
            "sort": 500000,
            "system": {
                "area": null,
                "cost": {
                    "value": ""
                },
                "counteraction": false,
                "damage": {
                    "0": {
