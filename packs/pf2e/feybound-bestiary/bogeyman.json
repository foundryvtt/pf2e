        {
            "_id": "Z8xxVdbOIwySbYym",
            "folder": "7cyoYPoPYA01mErU",
            "img": "systems/pf2e/icons/spells/phantasmal-killer.webp",
            "name": "Vision of Death",
            "sort": 500000,
            "system": {
                "area": null,
                "cost": {
                    "value": ""
                },
                "counteraction": false,
                "damage": {
                    "0": {
