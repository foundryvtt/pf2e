                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The jubjub bird rends the sky with a shrill note like a pencil on a slate. Non-Tane creatures within 120 feet must attempt a @Check[will|dc:40] save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is startled by the cry and becomes @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] for 1 round.</p>\n<p><strong>Failure</strong> The creature becomes @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 2} and is momentarily frozen with fear, becoming @UUID[Compendium.pf2e.conditionitems.Item.Immobilized] for 1 round.</p>\n<p><strong>Critical Failure</strong> The creature becomes @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 3} and is immobilized for as long as it remains frightened.</p>"
                },
                "publication": {
                    "license": "OGL",
