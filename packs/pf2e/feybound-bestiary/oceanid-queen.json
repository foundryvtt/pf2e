        {
            "_id": "j2qcJwtEHjpY6I1L",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Waveshaper",
            "sort": 1500000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p><strong>Frequency</strong> once per hour</p><hr /><p><strong>Effect</strong> The oceanid takes 1 minute to create waves and currents to double or halve the speed of creatures, objects, or vehicles traveling along the surface of the water within 1,000 feet, affecting up to 100 contiguous 5-foot squares in a shapable area (typically enough to affect 1 galley, 2 longships, or 3 cutters). This ability requires a line of sight to some part of the area and can be Sustained for up to 1 hour. An unwilling creature can resist the effect by succeeding at a @Check[fortitude|dc:35] save, which must be repeated once per minute for as long as it remains within the affected area.</p>"
                },
                "frequency": {
                    "max": 1,
                    "per": "PT1H"
                },
                "publication": {
                    "license": "OGL",
