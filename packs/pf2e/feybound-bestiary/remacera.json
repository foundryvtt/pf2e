        {
            "_id": "20uQinziIrKP5jhQ",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Curse of Renewal",
            "sort": 300000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "offensive",
                "description": {
                    "value": "<p>A creature damaged by a remacera's jaws must succeed at a @Check[will|dc:24] save or be afflicted with the curse of renewal. A creature that dies while affected by this curse is subjected to the effects of a successful @UUID[Compendium.pf2e.spells-srd.Item.Reincarnate] ritual that takes effect after 1 minute, regardless of whether the soul is willing to return.</p>"
                },
