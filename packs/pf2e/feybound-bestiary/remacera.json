        },
        {
            "_id": "D84IvA95JtuK5WOq",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Murderous Rhapsody",
            "sort": 400000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "offensive",
                "description": {
                    "value": "<p>When a creature the remacera reduced to 0 Hit Points dies, the remacera gains 10 temporary Hit Points that last for 1 minute and is @UUID[Compendium.pf2e.conditionitems.Item.Quickened] for as long as they have these temporary Hit Points. They can use the extra action only to Stride or Strike.</p>\n<p>@UUID[Compendium.pf2e.bestiary-effects.Item.Effect: Murderous Rhapsody]</p>"
                },
