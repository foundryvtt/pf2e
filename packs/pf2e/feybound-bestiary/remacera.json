        {
            "_id": "lwI69nDiTzf2Xtzj",
            "img": "systems/pf2e/icons/actions/TwoActions.webp",
            "name": "New Growth",
            "sort": 500000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The remacera spawns tiny, larval remaceras within a creature they can see within 100 feet. That creature must attempt a @Check[fortitude|dc:24|options:inflicts:clumsy,inflicts:sickened,inflicts:off-guard] save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature becomes @UUID[Compendium.pf2e.conditionitems.Item.Clumsy]{Clumsy 1} for 1 round as some larvae spawn on its skin before harmlessly falling off.</p>\n<p><strong>Failure</strong> As success, and the creature is @UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 2} as several larvae burrow out of its skin.</p>\n<p><strong>Critical Failure</strong> As failure, but the creature is @UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 3} and @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] while it remains sickened.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": [
                        "concentrate",
                        "manipulate",
                        "primal"
                    ]
                }
            },
            "type": "action"
        },
        {
            "_id": "4iAbVolJOgKlZRal",
            "img": "systems/pf2e/icons/actions/OneAction.webp",
            "name": "Ultrasonic Ululation",
            "sort": 600000,
            "system": {
                "actionType": {
