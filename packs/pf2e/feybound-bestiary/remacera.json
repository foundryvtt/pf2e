                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p>A remacera is permanently affected by their own curse of renewal. When a remacera dies, after 1 minute, their new body appears [[/gmr 1d20 #miles]] miles from where they died. They can also choose to retain their current form.</p>"
                },
