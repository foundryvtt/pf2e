        {
            "_id": "nDlZLMm28BCgldaw",
            "img": "systems/pf2e/icons/actions/TwoActions.webp",
            "name": "Umbral Detonation",
            "sort": 1000000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The radius of shadow menagerie is 20 feet or higher</p><hr /><p><strong>Effect</strong> A long shadow yawns out from the menagerie, withering everything it touches. Each creature in a @Template[type:line|distance:60] takes @Damage[8d6[void]|options:area-damage] damage with a @Check[reflex|dc:26|basic] save. A creature who critically fails is also @UUID[Compendium.pf2e.conditionitems.Item.Blinded] for 1 round. The shadow collector's aura decreases by 10 feet.</p>"
                },
