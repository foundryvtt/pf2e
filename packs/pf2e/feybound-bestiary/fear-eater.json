        {
            "_id": "PxeH3y6PsGXcIU3R",
            "img": "systems/pf2e/icons/actions/OneAction.webp",
            "name": "Feast on Fear",
            "sort": 1200000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The fear eater is adjacent to a creature that has a mushroom growing on it from Sprout Fear</p><hr /><p><strong>Effect</strong> The fear eater Interacts to pluck the mushroom and then eat it, regaining @Damage[3d8[healing]] Hit Points. The creature must succeed at a @Check[fortitude|dc:22] save or become @UUID[Compendium.pf2e.conditionitems.Item.Enfeebled]{Enfeebled 1} for 1 minute.</p>"
                },
                "publication": {
