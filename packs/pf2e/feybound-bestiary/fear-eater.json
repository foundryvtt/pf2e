        {
            "_id": "7u3QAKIVxpypv3zi",
            "img": "systems/pf2e/icons/actions/OneAction.webp",
            "name": "Sprout Fear",
            "sort": 1300000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The fear eater focuses their mind on a creature they can sense within 60 feet that has the frightened condition. That creature attempts a @Check[will|dc:22] save.</p>\n<p><strong>Success</strong> The target is unaffected.</p>\n<p><strong>Failure</strong> The target reduces the value of their frightened condition by 1 as the fear is concentrated into a fungus that bursts forth from their skin. The creature takes @Damage[1d6[persistent,bleed]] damage from the eruption. The mushroom remains for 10 minutes or until a creature Interacts to remove it; if that creature isn't a fear eater, the mushroom withers to nothing.</p>\n<p><strong>Critical Failure</strong> As failure but @Damage[2d6[persistent,bleed]] damage.</p>"
                },
                "publication": {
                    "license": "OGL",
