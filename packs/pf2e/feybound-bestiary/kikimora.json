            "sort": 1200000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "offensive",
                "description": {
                    "value": "<p>By commanding their home to attack, the kikimora can [[/act disarm skill=household-lore]], [[/act grapple skill=household-lore]], [[/act reposition skill=household-lore]], [[/act shove skill=household-lore]], or [[/act trip skill=household-lore]] with their enraged home Strike. The kikimora uses their Household Lore instead of Athletics skill for these checks.</p>"
                },
