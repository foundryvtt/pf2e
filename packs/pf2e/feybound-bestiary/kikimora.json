                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p>A kikimora is naturally @UUID[Compendium.pf2e.conditionitems.Item.Invisible] while within sight of their bound home. The kikimora can become visible or even selectively visible—allowing only certain people to see them.</p>"
