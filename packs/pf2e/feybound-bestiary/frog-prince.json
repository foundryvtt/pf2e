        {
            "_id": "wqvhTP98kZXDIOp5",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Watery Demesne",
            "sort": 600000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "interaction",
                "description": {
                    "value": "<p>The frog prince designates an unclaimed body of water (typically a pond) to become his demesne. While in his demesne, the frog prince can speak and gains a +15-foot status bonus to all his Speeds. If the frog prince dies or finds a new demesne, the waters turn murky and putrid for 1 week before returning to normal as it ceases to be his demesne.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [
