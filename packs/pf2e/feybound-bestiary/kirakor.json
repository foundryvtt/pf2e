        {
            "_id": "tRLvtGxweCixCU97",
            "img": "systems/pf2e/icons/actions/TwoActions.webp",
            "name": "Jaunty Jig",
            "sort": 900000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The kirakor dances, rubbing its legs together to emit a pleasant tune that inspires listeners to join in. Each non-fey creature within a @Template[type:emanation|distance:30] must attempt a @Check[will|dc:17] save. A kirakor can Sustain this effect for up to 1 minute, and the first time each round that the kirakor Sustains the effect in subsequent rounds, each non-fey creature in the emanation must attempt the save again.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected and is temporarily immune for 1 minute.</p>\n<p><strong>Success</strong> The creature is unaffected.</p>\n<p><strong>Failure</strong> The creature dances, becoming @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] and taking a –10-foot circumstance penalty to all its Speeds for 1 round.</p>\n<p><strong>Critical Failure</strong> As failure, and the creature becomes @UUID[Compendium.pf2e.conditionitems.Item.Slowed]{Slowed 1}.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": [
                        "auditory",
                        "emotion",
                        "mental"
                    ]
                }
            },
            "type": "action"
