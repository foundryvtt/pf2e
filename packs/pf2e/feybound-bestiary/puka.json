        {
            "_id": "hrf6zT1Io867D00h",
            "img": "systems/pf2e/icons/actions/OneAction.webp",
            "name": "Change Shape",
            "sort": 1100000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The puka takes on the appearance of one of the following creatures: a Tiny fox, hare, house cat, or raven; a Small dog, goat, or humanoid (most often a gnome or goblin); a Medium wolf or humanoid (most often an elf or human); or a Large horse. The humanoid shapes always include minor animalistic features. The puka keeps their normal Strikes, though their hoof strike deals slashing damage instead of bludgeoning in shapes with claws.</p><hr /><p>@Localize[PF2E.NPC.Abilities.Glossary.ChangeShape]</p>"
                },
                "publication": {
                    "license": "ORC",
