        {
            "_id": "RUvquPAnYSD6c1hK",
            "img": "systems/pf2e/icons/actions/OneAction.webp",
            "name": "Wild Ride",
            "sort": 1300000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Frequency</strong> once per day</p>\n<p><strong>Requirements</strong> The puka is invisible or in the shape of a horse, and is not in an encounter</p><hr /><p><strong>Effect</strong> The puka bursts into a run. Their land Speed becomes 90 feet until an hour passes, they stop moving, they enter an encounter, or they take damage, whichever comes first. Moving at this Speed nonstop for the full hour, the puka can typically cover 20–30 miles. If the puka bears a rider, that rider can't move from their mounted position or be harmed in any way until the Wild Ride ends. An unwilling rider can attempt to get off as soon as the puka starts moving, but must succeed at a @Check[acrobatics|dc:20] check or Reflex save.</p>"
                },
