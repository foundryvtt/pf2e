            },
            "type": "action"
        },
        {
            "_id": "RKEeVJMtKaRojeRI",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Bloodsense",
            "sort": 1000000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The sangoi can hear the beating hearts and smell the rushing blood of all living creatures as an imprecise sense within the listed range. They can detect creatures taking persistent bleed damage as a precise sense.</p>"
                },
                "publication": {
