        {
            "_id": "GgY2Wt9ZTkRYVWcy",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Curse of Misery",
            "sort": 1100000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "offensive",
                "description": {
                    "value": "<p>A creature hit by a sangoi's claws Strike must succeed at a @Check[will|dc:22] save or become cursed for 1 minute. This curse imparts a –1 status penalty to a victim's AC and saving throws against the sangoi who cursed them. In addition, when a cursed victim attempts the flat check to recover from any persistent bleed damage, they must roll twice and take the worse result; this is a misfortune effect.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": [
