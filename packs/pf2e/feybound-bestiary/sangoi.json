        {
            "_id": "GCaIjFZI0MXpEpnX",
            "img": "systems/pf2e/icons/actions/TwoActions.webp",
            "name": "Vicious Draught",
            "sort": 1300000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> A creature within the sangoi's reach is taking persistent bleed damage</p><hr /><p><strong>Effect</strong> The sangoi latches onto the creature's open wound, drinking their blood. They attempt a jaws Strike against the target; if the target is willing, the Strike automatically hits. If the Strike hits, the persistent bleed condition ends, the target is @UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 1}, and the sangoi regains Hit Points equal to the target's level, gaining any excess HP as temporary HP. Taking a Vicious Draught from a creature that's already drained doesn't restore any HP to the sangoi but increases the victim's drained value by 1 (to a maximum of @UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 4}).</p>\n<p>If the sangoi is in a Blood Rage and the jaws Strike reduces the target to 0 HP, the victim must attempt a @Check[fortitude|dc:22] save. On a failure, the sangoi tears out the target's heart and devours it, killing it instantly. This is a death effect.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": [
                        "occult"
                    ]
                }
            },
            "type": "action"
        }
