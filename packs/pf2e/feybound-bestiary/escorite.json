        },
        {
            "_id": "C13p5oPQJsImHxNy",
            "img": "systems/pf2e/icons/actions/TwoActions.webp",
            "name": "Hollow Eyes",
            "sort": 1100000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The escorite focuses the forces of entropy upon a creature they can see within 60 feet. The creature takes @Damage[8d6[void]] damage and must attempt a @Check[fortitude|dc:26] save.</p><hr /><p><strong>Critical Success</strong> The creature takes no damage.</p>\n<p><strong>Success</strong> The creature takes half damage and is @UUID[Compendium.pf2e.conditionitems.Item.Enfeebled]{Enfeebled 1} for 1 round.</p>\n<p><strong>Failure</strong> The creature takes full damage and is @UUID[Compendium.pf2e.conditionitems.Item.Enfeebled]{Enfeebled 2} for 1 round. A creature reduced to 0 HP by this damage immediately turns to dust, including all items it's currently carrying; the creature can be restored only via a @UUID[Compendium.pf2e.spells-srd.Item.Wish] ritual or similarly powerful effect.</p>\n<p><strong>Critical Failure</strong> As failure, but the creature takes double damage and is enfeebled 2 for 1 minute.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
