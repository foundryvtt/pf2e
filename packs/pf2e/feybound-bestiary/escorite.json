        {
            "_id": "MiYKedv5I2hhUC2W",
            "img": "systems/pf2e/icons/actions/ThreeActions.webp",
            "name": "Entropic Flurry",
            "sort": 1000000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 3
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The escorite makes up to four tentacle Strikes, each against a different target within reach. The void damage from these Strikes is persistent void damage instead. Each attack counts toward their multiple attack penalty, but the penalty doesn't increase until after the escorite makes all their attacks.</p>"
                },
                "publication": {
                    "license": "OGL",
