        {
            "_id": "7Vdr6FikFFzqdMtj",
            "img": "systems/pf2e/icons/actions/OneAction.webp",
            "name": "Deteriorating Flight",
            "sort": 900000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Frequency</strong> once per round</p><hr /><p><strong>Effect</strong> The escorite Flies, shedding dust from their wings, and can move through the spaces of any creatures in their path. Each creature whose space they move through takes @Damage[3d6[void]] damage (@Check[reflex|dc:26|basic] save). On a failure, an invisible creature also becomes @UUID[Compendium.pf2e.conditionitems.Item.Concealed] instead for 1 round.</p>"
                },
