        {
            "_id": "bftdv71wnr4786h4",
            "img": "systems/pf2e/icons/actions/TwoActions.webp",
            "name": "Call of the Damned",
            "sort": 1400000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The queen sends out shriek to all sluagh within 1 mile, summoning them to her. This typically calls [[/r 2d4]] @UUID[Compendium.pf2e.book-of-the-dead-bestiary.Actor.Sluagh Reaper]{Sluagh Reapers}. If the queen is facing foes strong enough to threaten her, these are likely too weak to pose a threat but can assist by fetching items or getting in enemies' way.</p>"
                },
                "publication": {
