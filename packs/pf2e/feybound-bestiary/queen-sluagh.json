        {
            "_id": "Ypr2eG67oU4zRG15",
            "img": "icons/magic/control/control-influence-crown-gold.webp",
            "name": "Overwhelming Presence",
            "sort": 200000,
            "system": {
                "area": {
                    "type": "burst",
