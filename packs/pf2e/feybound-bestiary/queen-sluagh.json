                    ]
                }
            },
            "type": "action"
        },
        {
            "_id": "272bll9hrxa49hmf",
            "img": "systems/pf2e/icons/actions/OneAction.webp",
            "name": "Ghostly Swoop",
            "sort": 1600000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The queen sluagh becomes incorporeal until the start of their next turn, and Flies up to their fly Speed. While incorporeal, they are immune to precision damage, and have resistance 10 to all damage (except force, @UUID[Compendium.pf2e.equipment-srd.Item.Ghost Touch], or vitality); this resistance is doubled against non-magical damage.The sluagh queen can't use Ghostly Swoop again for [[/gmr 1d4 #Recharge Ghostly Swoop]]{1d4 rounds}.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [
                    {
                        "key": "RollOption",
