            "img": "systems/pf2e/icons/actions/TwoActions.webp",
            "name": "Copied Clutter",
            "sort": 1000000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Frequency</strong> once per day</p><hr /><p><strong>Effect</strong> The mirmicette creates dozens of copies of an object of 1 Bulk or less that the mirmicette can see. The counterfeit items rain down in a @Template[type:burst|distance:10] within 40 feet. The ground in the area becomes difficult terrain until the items are collected and removed. Creatures in the area must attempt a @Check[reflex|dc:24|options:area-effect,damaging-effect,inflicts:off-guard,inflicts:prone] save.</p>\n<p><strong>Success</strong> The creature takes @Damage[2d6[bludgeoning]|options:area-damage] damage.</p>\n<p><strong>Failure</strong> The creature takes @Damage[4d6[bludgeoning]|options:area-damage] damage and is @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] for 1 round.</p>\n<p><strong>Critical Failure</strong> The creature takes @Damage[8d6[bludgeoning]|options:area-damage] damage and is knocked @UUID[Compendium.pf2e.conditionitems.Item.Prone].</p>"
                },
                "frequency": {
                    "max": 1,
                    "per": "day"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
