        {
            "_id": "bQAaD9ShZ5Icu7PZ",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Silent Agony",
            "sort": 1100000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p>30 feet. When a creature ends its turn in the aura, it feels as if its mouth is sealing shut with excruciating pain. The creature must succeed at a @Check[will|dc:36] save or become @UUID[Compendium.pf2e.conditionitems.Item.Stupefied]{Stupefied 2} for 1 round. On a critical failure, it also can't make any sound with its mouth for as long as it's stupefied. This prevents it from using sonic or auditory actions that require its mouth, casting spells, and using linguistic actions. Velstracs are immune to this effect.</p>"
                },
                "publication": {
