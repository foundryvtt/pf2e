        {
            "_id": "m41xKimIh9ELZu6i",
            "_stats": {
                "compendiumSource": "Compendium.pf2e.bestiary-family-ability-glossary.Item.unR8VVR4yyRnsmnB"
            },
            "folder": "LOmu7fmjWOthtbvt",
