            "sort": 400000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "deathNote": true,
                "description": {
                    "value": "<p>Destroying Deravon's link to the world—his magical helm—prevents him from rejuvenating and allows him to move on to the afterlife once he is destroyed.</p><hr /><p>When a ghost is destroyed, it re-forms after [[/br 2d4 #days]]{2d4 days} within the location it's bound to, fully healed. A ghost can be permanently destroyed only if someone determines the reason for its existence and sets right whatever prevents the spirit from resting.</p>"
                },
                "publication": {
                    "license": "ORC",
                    "remaster": true,
                    "title": "Pathfinder Monster Core"
                },
