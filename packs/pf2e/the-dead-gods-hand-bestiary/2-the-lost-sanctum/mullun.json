        {
            "_id": "94LbIPF3H3BE6mLw",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Recognizable Stench",
            "sort": 500000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p>10 feet. While Mullun's odor isn't normally overwhelming, the mix of ogre sweat, filth, and blood that surrounds him is enough to trigger lingering trauma in the minds of any former Clan Orthux captives (including the PCs and their NPC allies). A PC who ends their turn in the aura must succeed at a @Check[will|dc:18] save.</p><hr /><p><strong>Critical Success</strong> The character is unaffected and immune to the aura.</p>\n<p><strong>Success</strong> The character is unaffected.</p>\n<p><strong>Failure</strong> The character becomes @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 1}.</p>\n<p><strong>Critical Failure</strong> The character becomes @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 2}.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [
                    {
                        "key": "Aura",
                        "radius": 10
                    }
                ],
                "slug": null,
                "traits": {
                    "value": [
                        "aura",
                        "emotion",
                        "fear",
                        "mental",
                        "olfactory"
                    ]
                }
            },
            "type": "action"
        },
        {
