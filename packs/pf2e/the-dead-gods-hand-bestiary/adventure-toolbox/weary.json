        {
            "_id": "7o9ClX1WvFtuB9k8",
            "img": "systems/pf2e/icons/actions/TwoActions.webp",
            "name": "Empty Yawn",
            "sort": 400000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Frequency</strong> once per hour</p><hr /><p><strong>Effect</strong> The weary's jaws stretch open to an unnatural extent, giving cry to a horrific, chilling wail of exhaustion that cuts into the minds of nearby living creatures. Instilled in their thoughts is the sensation of the anguish of being dead, yet conscious of the body's slow decay. Living creatures within a @Template[type:emanation|distance:20] take @Damage[1d6[mental]|options:area-damage] damage with a @Check[will|dc:16] save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes half damage.</p>\n<p><strong>Failure</strong> The creature takes full damage and is @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 1}.</p>\n<p><strong>Critical Failure</strong> The creature takes double damage and is @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 2}.</p>"
                },
                "frequency": {
                    "max": 1,
                    "per": "PT1H"
                },
