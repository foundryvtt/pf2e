        {
            "_id": "065G2HYp4XesZF5h",
            "img": "systems/pf2e/icons/actions/TwoActions.webp",
            "name": "Cherub’s Arrow",
            "sort": 1100000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The cherub concentrates on an arrow they have nocked in their bow, imbuing it with supernatural power before firing it at a target within 30 feet. The arrow inflicts no damage on a hit, and instead has one of the following effects, chosen by the cherub. While the cherub can use this ability every round if they so choose, they can never pick the same effect twice in a row. A creature struck must succeed at a @Check[will|dc:16] save or be affected as follows, depending on the cherub's choice (on a critical hit, the creature takes a –2 penalty to the saving throw).</p>\n<p><strong>Delight</strong> The target becomes @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] as they become distracted by all the wonders of life until the start of the cherub's next turn.</p>\n<p><strong>Love</strong> The target becomes @UUID[Compendium.pf2e.conditionitems.Item.Fascinated] for 1 minute by a second, non-cherub creature within 30 feet of the cherub whom the target can see. This effect has the visual trait.</p>\n<p><strong>Peace</strong> The target is filled with a sense of tranquility and takes a –1 status penalty to attack rolls for 1 minute.</p>\n<p><strong>Regret</strong> The target becomes filled with shame and remorse, becoming @UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 1} (@UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 2} on a critical failure).</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
