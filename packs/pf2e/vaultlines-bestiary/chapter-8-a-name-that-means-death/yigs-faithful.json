            },
            "type": "action"
        },
        {
            "_id": "GuuWdiv92S9JU9RB",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Ghostly Fangs",
            "sort": 800000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><span class=\"action-glyph\">1</span> to <span class=\"action-glyph\">3</span></p><hr /><p><strong>Frequency</strong> once per round</p><hr /><p><strong>Effect</strong> Yig's faithful strike out with sacred punching daggers against each enemy within 5 feet (@Check[reflex|dc:40|basic|options:area-effect] save). The damage depends on the number of actions.</p>\n<p><span class=\"action-glyph\">1</span> @Damage[(1d8+2)[slashing],1d8[void]|options:area-effect] damage</p>\n<p><span class=\"action-glyph\">2</span> @Damage[(2d8+14)[slashing],2d8[void]|options:area-effect] damage</p>\n<p><span class=\"action-glyph\">3</span> @Damage[(3d8+14)[slashing],3d8[void]|options:area-effect] damage</p>"
                },
                "frequency": {
                    "max": 1,
                    "per": "round"
                },
