        {
            "_id": "vFe36uIHulZ5o7yY",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Activate Rotor",
            "sort": 400000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The vault lifter's rotor spins, becoming a buzzing blur. While the rotor is activated, the lifter gains a fly Speed of 40 feet. The spinning rotor also creates an aura in a @Template[type:emanation|distance:5] around the lifter. Any creature that enters or starts its turn in the area must attempt a @Check[fortitude|dc:34|options:damaging-effect,forced-movement,inflicts:prone] save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected, and the vault lifter's rotor is deactivated. The lifter loses its fly Speed and aura until it Activates Rotor again.</p>\n<p><strong>Success</strong> The creature takes @Damage[2d8[slashing]|options:area-damage] damage.</p>\n<p><strong>Failure</strong> The creature takes @Damage[4d8[slashing]|options:area-damage] damage.</p>\n<p><strong>Critical Failure</strong> The creature takes @Damage[8d8[slashing]|options:area-damage] damage. If the creature isn't @UUID[Compendium.pf2e.conditionitems.Item.Grabbed] or @UUID[Compendium.pf2e.conditionitems.Item.Restrained] by the vault lifter, they are pushed back 15 feet and knocked @UUID[Compendium.pf2e.conditionitems.Item.Prone].</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [
                    {
                        "key": "RollOption",
                        "option": "activate-rotor",
                        "toggleable": true
                    },
                    {
                        "key": "BaseSpeed",
                        "predicate": [
                            "activate-rotor"
                        ],
                        "selector": "fly",
                        "value": 40
                    },
                    {
                        "key": "Aura",
                        "predicate": [
                            "activate-rotor"
                        ]
                    }
                ],
                "slug": null,
                "traits": {
                    "value": [
                        "magical"
                    ]
                }
            },
            "type": "action"
        },
