        {
            "_id": "5XZdpEzdzPxvv0oy",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Antiques",
            "sort": 1000000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "interaction",
                "description": {
                    "value": "<p>Each primordial echo possesses a signature magical item. The echo of Ayrzul holds the Might of the Blistering Labyrinth, a <em>+3 greater striking high-grade abysium morningstar</em>. The echo of Sairazul wears <em>Pellucid Mercy</em>, a glittering crystal diadem that functions as a @UUID[Compendium.pf2e.equipment-srd.Item.Sage's Lash]. The echo of Cernock carries Builder's Ingenuity, a <em>+3 greater striking halberd</em> carved from green crystal that also functions as a @UUID[Compendium.pf2e.equipment-srd.Item.Staff of Earth (Major)]{Major Staff of Earth}. The echo gains the benefits of its item as if wearing or holding it and can activate its abilities, but it doesn't wield the item in combat.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
