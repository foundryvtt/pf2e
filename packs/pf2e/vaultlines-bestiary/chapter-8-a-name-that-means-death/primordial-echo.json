                },
                "actions": {
                    "value": null
                },
                "category": "offensive",
                "description": {
                    "value": "<p>Any creature hit by the locus's ancient stone Strike is partially buried in a tide of earth and rock, becoming @UUID[Compendium.pf2e.conditionitems.Item.Immobilized] ([[/act escape dc=38]]).</p>"
                },
