                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p><strong>Trigger</strong> The thruneosaurus takes damage from a holy effect</p><hr /><p><strong>Effect</strong> The thruneosaurus teleports to an open space within 60 feet it can see, along with any creatures it has swallowed whole.</p>"
                },
