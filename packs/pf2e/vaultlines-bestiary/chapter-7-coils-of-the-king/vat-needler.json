        },
        {
            "_id": "Ds5r4OM9Cyys0J94",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Alchemical Injection",
            "sort": 400000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "offensive",
                "description": {
                    "value": "<p>When a noxious needler hits a creature with a syringe Strike, roll 1d6 on the alchemical chambers list to determine the additional effect of the attack. The syringe deals an additional 2d6 damage of the appropriate type (or exposes the target to the sickness effect, as appropriate).</p><table class=\"pf2e remaster\"><thead><tr><th><p>[[/gmr 1d6 #Alchemical Injection]]</p></th><th><p>Alchemical Effect</p></th></tr></thead><tbody><tr><td><p>1</p></td><td><p>Acid</p></td></tr><tr><td><p>2</p></td><td><p>Cold</p></td></tr><tr><td><p>3</p></td><td><p>Electricity</p></td></tr><tr><td><p>4</p></td><td><p>Fire</p></td></tr><tr><td><p>5</p></td><td><p>Poison</p></td></tr><tr><td><p>6</p></td><td><p>Sickness: @Check[fortitude|dc:26|options:inflicts:sickened] save or @UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 1} (@UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 2} on a critical failure)</p></td></tr></tbody></table>"
                },
                "publication": {
                    "license": "ORC",
                    "remaster": true,
                    "title": ""
                },
                "rules": [
                    {
