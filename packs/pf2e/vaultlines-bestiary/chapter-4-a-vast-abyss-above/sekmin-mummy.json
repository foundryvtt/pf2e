            "name": "Blighted Consumption",
            "sort": 300000,
            "system": {
                "actionType": {
                    "value": "reaction"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p><strong>Trigger</strong> A creature within 30 feet eats or drinks (including an alchemical item or potion)</p><hr /><p><strong>Effect</strong> The food or drink burns like the caustic substances fed to the mummy before its death. If the creature fails a @Check[fortitude|dc:30|options:inflicts:sickened] save, they become @UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 2} after they finish the consumption and can't reduce their sickened condition while within 30 feet of any mummy.</p>"
                },
                "publication": {
                    "license": "ORC",
