            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Choking Pain",
            "sort": 400000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The mummy's last action was a successful fist Strike</p><hr /><p><strong>Effect</strong> The mummy shares the pain of its dying moments with the target of that Strike. That creature takes @Damage[5d8[void]] damage with a @Check[will|dc:30|basic] save. If the creature critically fails the saving throw, it can't speak for 1 round, including to Cast a Spell.</p>"
                },
