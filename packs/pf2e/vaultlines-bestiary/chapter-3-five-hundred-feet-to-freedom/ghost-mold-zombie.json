                },
                "category": "defensive",
                "description": {
                    "value": "<p><strong>Frequency</strong> once per round</p>\n<p><strong>Trigger</strong> The ghost mold zombie takes vitality damage</p><hr /><p><strong>Effect</strong> A burst of paranoia-inducing spores emerges from the zombie in a @Template[type:emanation|distance:10]. All creatures in the area must attempt a @Check[will|dc:29|options:area-effect,inflicts:frightened] save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature is @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 1}.</p>\n<p><strong>Failure</strong> The creature is @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 3}.</p>\n<p><strong>Critical Failure</strong> As failure, except the creature doesn't treat any creature as an ally for as long as it remains frightened.</p>"
                },
                "frequency": {
                    "max": 1,
                    "per": "round"
                },
