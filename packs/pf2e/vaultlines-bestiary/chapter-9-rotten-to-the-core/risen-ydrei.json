        {
            "_id": "0Dsu9Ymn8cqEMxUN",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Impenetrable Scales",
            "sort": 700000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Frequency</strong> once per minute</p>\n<p><strong>Requirements</strong> The risen ydrei has taken physical damage since the end of its last turn</p><hr /><p><strong>Effect</strong> The risen ydrei's immortal essence infuses its scales, making it virtually impervious to further blows. Until the start of its next turn, the risen ydrei gains resistance 20 to physical damage.</p>"
                },
                "frequency": {
