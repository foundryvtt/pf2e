        {
            "_id": "tIQo96U62WG010p4",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Slithering Surge",
            "sort": 900000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Frequency</strong> once per minute</p>\n<p><strong>Requirements</strong> The risen ydrei's previous action was a successful Strike, and it doesn't have a creature @UUID[Compendium.pf2e.conditionitems.Item.Grabbed]</p><hr /><p><strong>Effect</strong> The risen ydrei is empowered by its immortal essence to momentarily transcend the limitations of its undead form, darting across the battlefield in a murderous blur. It immediately Strides up to 25 feet and makes another attack of the same type against a different creature. This Strike uses the same multiple attack penalty as the previous one, but it counts toward the risen ydrei's multiple attack penalty as usual.</p>"
                },
                "frequency": {
                    "max": 1,
                    "per": "PT1M"
                },
