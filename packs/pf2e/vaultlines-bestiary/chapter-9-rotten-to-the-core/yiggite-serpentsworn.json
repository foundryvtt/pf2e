            "sort": 500000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p>60 feet. A living creature entering or starting its turn in the aura takes @Damage[6d6[void]|options:area-damage] damage (@Check[fortitude|dc:40|basic|options:area-effect,inflicts:doomed,inflicts:drained] save). Plant creatures and creatures made of water (such use an outcome one degree of success worse than the result of their saving throw, whereas creatures whose bodies contain no significant moisture are immune. On a critical failure, a creature becomes @UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 2} and @UUID[Compendium.pf2e.conditionitems.Item.Doomed]{Doomed 1}. On a critical success, they become temporarily immune to the serpentsworn's desiccating aura for 24 hours.</p>"
                },
                "publication": {
                    "license": "OGL",
