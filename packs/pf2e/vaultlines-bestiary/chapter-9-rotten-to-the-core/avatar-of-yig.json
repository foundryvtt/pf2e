        {
            "_id": "Achw07K1ij3fBfiD",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Erosion Aura",
            "sort": 600000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p>120 feet. The avatar of Yig erodes away the physical integrity of all around it. Creatures and objects in the emanation other than the avatar have their Hardness and resistances reduced by 15. At the start of their turn, a creature in the erosion aura's area takes @Damage[6d10[bludgeoning]|options:area-damage] damage with a @Check[fortitude|dc:43|basic|options:area-effect] save.</p>"
                },
                "publication": {
                    "license": "ORC",
