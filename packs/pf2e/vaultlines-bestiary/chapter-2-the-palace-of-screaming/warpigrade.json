        {
            "_id": "t1gkQiBthXezL85x",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Tun State",
            "sort": 400000,
            "system": {
                "actionType": {
                    "value": "free"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "deathNote": true,
                "description": {
                    "value": "<p><strong>Trigger</strong> The warpigrade would be reduced to 0 Hit Points or would die due to starvation, suffocation, or similar environmental causes</p>\n<p><strong>Frequency</strong> once per week</p>\n<p><strong>Requirements</strong> The warpigrade isn't already in tun state</p><hr /><p><strong>Effect</strong> The warpigrade doesn't die but instead remains at 1 Hit Point and curls into a dry ball, called a tun. While in this tun state, the warpigrade is @UUID[Compendium.pf2e.conditionitems.Item.Unconscious], doesn't need to eat, drink, or breathe, and doubles its resistance to 20. It remains in tun state indefinitely until covered in significant amounts of water, at which point it begins to rehydrate, gaining regeneration 5. The regeneration persists until it reaches maximum Hit Points. The warpigrade then exits its tun state.</p>"
                },
                "frequency": {
                    "max": 1,
                    "per": "P1W"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [
                    {
                        "key": "RollOption",
                        "option": "tun-state",
                        "suboptions": [
                            {
                                "label": "PF2E.NPCAbility.GiantTardigrade.TunState.Dry",
                                "value": "dry"
                            },
                            {
                                "label": "PF2E.NPCAbility.GiantTardigrade.TunState.Rehydrating",
                                "value": "rehydrating"
                            }
                        ],
                        "toggleable": true
                    },
                    {
                        "inMemoryOnly": true,
                        "key": "GrantItem",
                        "predicate": [
                            "tun-state"
                        ],
                        "uuid": "Compendium.pf2e.conditionitems.Item.Unconscious"
                    },
                    {
                        "key": "Resistance",
                        "predicate": [
                            "tun-state"
                        ],
                        "type": "all-damage",
                        "value": 20
                    },
                    {
                        "key": "FastHealing",
                        "predicate": [
                            "tun-state:rehydrating"
                        ],
                        "value": 5
                    }
                ],
                "slug": null,
                "traits": {
                    "value": []
                }
            },
            "type": "action"
        },
        {
            "_id": "5l6l57vUubo2m04g",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Ingest Aspect",
            "sort": 500000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The warpigrade has a creature @UUID[Compendium.pf2e.conditionitems.Item.Grabbed] with its pincers</p><hr /><p><strong>Effect</strong> The warpigrade makes a stylet Strike. If it succeeds, the warpigrade attempts to absorb some of the victim's essence. The creature attempts a @Check[fortitude|dc:33] save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature becomes @UUID[Compendium.pf2e.conditionitems.Item.Clumsy]{Clumsy 1} or @UUID[Compendium.pf2e.conditionitems.Item.Enfeebled]{Enfeebled 1} (determine randomly) for 1 round. If the creature becomes clumsy, the warpigrade gains a +1 status bonus to its AC and Reflex save for 1 round; if the creature becomes enfeebled, the warpigrade instead gains the bonus to its attack and damage rolls.</p>\n<p><strong>Failure</strong> As success, except if the creature is already clumsy or enfeebled, the condition value and corresponding status bonus increase by 1 (to a maximum of 4), and the effect lasts for 1 minute.</p>\n<p><strong>Critical Failure</strong> As failure, except the condition value and status bonus increase by 2.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": [
                        "mental",
                        "occult"
                    ]
                }
            },
            "type": "action"
        },
        {
            "_id": "zanTwx7iAQUEbNpS",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Vacuum Mouth",
            "sort": 600000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The warpigrade doesn't have a target @UUID[Compendium.pf2e.conditionitems.Item.Grabbed]</p><hr /><p><strong>Effect</strong> The warpigrade draws in air with its mouth. All creatures in a @Template[cone|distance:20] must succeed at a @Check[reflex|dc:30|options:area-effect,forced-movement] save or be pulled adjacent to the warpigrade. The warpigrade chooses one creature that failed its save, Grabbing the target in its claws and making a stylet Strike.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
