        {
            "_id": "YqoEgtlagOIPp7DQ",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Devouring Squeeze",
            "sort": 600000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The knucklehead has a creature @UUID[Compendium.pf2e.conditionitems.Item.Restrained] in its head hand</p>\n<p><strong>Frequency</strong> once per round</p><hr /><p><strong>Effect</strong> The knucklehead squeezes the creature, gnawing hungrily through both armor and flesh. The creature takes @Damage[(2d10+10)[bludgeoning]] damage, and if the creature is wearing armor with Hardness 14 or lower, the armor is @UUID[Compendium.pf2e.conditionitems.Item.Broken]. If the creature isn't wearing armor or if its armor is already broken, the creature instead takes an additional @Damage[2d10[piercing]] damage, and the knucklehead regains Hit Points equal to the amount of piercing damage dealt.</p>"
                },
                "frequency": {
                    "max": 1,
                    "per": "round"
                },
                "publication": {
