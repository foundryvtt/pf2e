        {
            "_id": "EWiZ9UF5VvTbytHb",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Drain Blood",
            "sort": 400000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The strangleroot has a creature @UUID[Compendium.pf2e.conditionitems.Item.Restrained]</p><hr /><p><strong>Effect</strong> The restrained creature takes @Damage[3d10[bleed]] damage and becomes @UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 1}. The strangleroot regains HP equal to the bleed damage dealt and becomes blood engorged. The strangleroot doesn't gain Hit Points from draining a creature that's already drained, but the creature's drained value increases by 1, killing them when they reach @UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 5}. A creature's drained condition decreases by 1 per hour.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
