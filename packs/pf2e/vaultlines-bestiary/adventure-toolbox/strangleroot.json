                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The strangleroot is blood engorged</p><hr /><p><strong>Effect</strong> The strangleroot sprays sap-poisoned blood in a @Template[type:emanation|distance:20]. Each creature in the emanation takes @Damage[6d10[poison]|options:area-damage] damage with a @Check[reflex|dc:25|basic|options:area-effect] save. Afterward, the strangleroot is no longer blood engorged.</p>"
                },
