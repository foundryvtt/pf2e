        {
            "_id": "C8b4aT9N2T7dxUre",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Retract",
            "sort": 600000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The strangleroot doesn't have a creature @UUID[Compendium.pf2e.conditionitems.Item.Grabbed] or @UUID[Compendium.pf2e.conditionitems.Item.Restrained]</p><hr /><p><strong>Effect</strong> The strangleroot retracts its dangling roots into the ceiling or re-extends its roots. While retracted, the strangleroot can't be targeted by attacks or effects, and it can't take any action except to extend its roots, reappearing in another space within 15 feet of the space it left. If a creature digs through 1 foot of the earth and stone, it removed the earthen layer protecting the strangleroot; the strangleroot is no longer retracted and can't use Retract again.</p>"
                },
                "publication": {
