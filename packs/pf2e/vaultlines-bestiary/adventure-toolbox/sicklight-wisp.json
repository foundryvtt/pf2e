            "sort": 700000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p>The sicklight wisp deactivates their Sicklight Glow, becoming @UUID[Compendium.pf2e.conditionitems.Item.Invisible]. They can end this effect with another use of this action. If the wisp makes a radioactive touch Strike while invisible, the tracing of green energy left behind lets any observer determine the wisp's location, making them only @UUID[Compendium.pf2e.conditionitems.Item.Hidden] to all observers until the wisp moves.</p>"
                },
                "frequency": null,
                "publication": {
