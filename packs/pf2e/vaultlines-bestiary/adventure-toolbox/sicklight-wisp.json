        {
            "_id": "Mb2hibsXLWjucuqE",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Sickening Touch",
            "sort": 800000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "offensive",
                "description": {
                    "value": "<p>A creature hit by the sicklight wisp's radioactive touch Strike or that ends its turn in the wisp's sicklight glow aura must succeed at a @Check[fortitude|dc:33|options:inflicts:sickened] save or become @UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 1} (@UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 2} on a critical failure). If the creature is already sickened, their sickened value instead increases by 1 (by 2 on a critical failure), to a maximum of @UUID[Compendium.pf2e.conditionitems.Item.Sickened]{Sickened 4}. If the creature reaches sickened 4, they can't reduce their sickened value until the effect is counteracted by a cleanse affliction spell or similar effect.</p>"
                },
