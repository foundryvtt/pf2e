        },
        {
            "_id": "QRGedJRn4uTrV6b7",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Bloodletting",
            "sort": 900000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> Naptha's last action was a melee scalpel Strike that did precision damage</p><hr /><p><strong>Effect</strong> Naptha attempts a @Check[medicine|against:medicine|options:inflicts:drained] check against the target's Fortitude DC. On a success, the creature becomes @UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 1} (@UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 2} on a critical success) or increases its drained condition value by 1 (or by 2 on a critical success), to a maximum of @UUID[Compendium.pf2e.conditionitems.Item.Drained]{Drained 4}.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": []
