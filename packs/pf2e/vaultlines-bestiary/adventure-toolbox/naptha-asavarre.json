            "type": "action"
        },
        {
            "_id": "6bNWsrkPNkW7T3N6",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Surgical Precision",
            "sort": 1100000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p>Naptha attempts a @Check[medicine|against:fortitude] check against the Fortitude DC of one living creature she can see within 30 feet. On a success, until the end of her turn Naptha's scalpel Strikes deal an extra 8d4 precision damage against that creature; on a critical success, her scalpel Strikes against the creature also deal 4d4 persistent bleed damage. On a critical failure, the creature gains temporary immunity to Surgical Precision for 1 day.</p>"
                },
