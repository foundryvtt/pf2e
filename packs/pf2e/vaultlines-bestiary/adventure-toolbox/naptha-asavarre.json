        },
        {
            "_id": "pWLxpPVDyigBFboc",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Carbauxine Breath",
            "sort": 1000000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p>Naptha exhales a gout of carbauxine gas and ignites it, creating a blast that deals @Damage[15d6[fire]|options:area-damage] damage to all creatures in a @Template[type:cone|distance:30] or @Template[type:line|distance:60] (@Check[reflex|dc:34|basic|options:area-effect] save). Naptha can't use Carbauxine Breath again for [[/gmr 1d4 #Recharge Carbauxine Breath]]{1d4 rounds}.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
