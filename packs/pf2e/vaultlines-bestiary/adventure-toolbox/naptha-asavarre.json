            "system": {
                "actionType": {
                    "value": "reaction"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p><strong>Trigger</strong> Naptha fails or critically fails a saving throw against an emotion effect</p><hr /><p><strong>Effect</strong> Naptha clamps down her emotions. She rerolls the saving throw, using the second result. She is then @UUID[Compendium.pf2e.conditionitems.Item.Slowed]{Slowed 1} on her next turn.</p>"
                },
                "publication": {
                    "license": "OGL",
