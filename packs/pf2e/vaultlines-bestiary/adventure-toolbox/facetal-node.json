        {
            "_id": "rm5pbjc5jiyG1vtd",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Gem Form",
            "sort": 500000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p>When a facetal node is reduced to 0 Hit Points, their hardlight body is destroyed, leaving behind the node's true form, a Tiny glowing gemstone. In this form, the node's Speed is 0, they're immune to damage, and they're deactivated. While deactivated, they can't take actions or speak, although they can use telepathy. The node remains deactivated until it reactivates at a time determined by the GM (usually after decades or more).</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": []
                }
            },
            "type": "action"
        },
