        {
            "_id": "la7Slvp1xzHUwaJr",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Not Done With You!",
            "sort": 500000,
            "system": {
                "actionType": {
                    "value": "reaction"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p><strong>Trigger</strong> A creature within Baulrica's reach leaves a square during a move action it's using</p><hr /><p><strong>Effect</strong> Baulrica attempts to [[/act grapple]] the creature. On a success, the creature is also @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 1}.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
