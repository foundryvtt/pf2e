        {
            "_id": "zTzNB3rVZBxKE4ek",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Rewrite Records",
            "sort": 700000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p>Azotixo attempts to scramble the memories of a creature within 30 feet, filling their mind with terrifying images. The creature attempts a @Check[will|dc:30|options:damaging-effect,inflicts:frightened] save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected and becomes temporarily immune to Rewrite Records for 1 day.</p>\n<p><strong>Success</strong> The creature takes @Damage[4d6[mental]] damage.</p>\n<p><strong>Failure</strong> The creature takes @Damage[8d6[mental]] damage and is @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 1}.</p>\n<p><strong>Critical Failure</strong> As failure, but the creature is @UUID[Compendium.pf2e.conditionitems.Item.Frightened]{Frightened 2}.</p>"
                },
                "publication": {
                    "license": "OGL",
