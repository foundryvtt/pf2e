            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "offensive",
                "description": {
                    "value": "<p>Azotixo deals 1d6 extra precision damage to frightened or @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] creatures.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
