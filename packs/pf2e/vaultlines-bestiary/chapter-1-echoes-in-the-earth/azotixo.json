        },
        {
            "_id": "Fb5p1u5flfUo8kFo",
            "img": "systems/pf2e/icons/default-icons/action.svg",
            "name": "Leave in the Dark",
            "sort": 500000,
            "system": {
                "actionType": {
                    "value": "reaction"
                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p><strong>Trigger</strong> A creature attempts to @UUID[Compendium.pf2e.actionspf2e.Item.Recall Knowledge] about Azotixo and fails</p><hr /><p><strong>Effect</strong> Failing to properly recognize the caligni archivist creates a mental feedback loop. If the triggering check was a failure, the creature is @UUID[Compendium.pf2e.conditionitems.Item.Off-Guard] for 1 round. On a critical failure, the creature becomes @UUID[Compendium.pf2e.conditionitems.Item.Confused] for 1 round instead.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": [
                        "curse",
                        "mental",
                        "occult"
                    ]
                }
            },
            "type": "action"
        },
        {
