                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p>When a mannoq beast would be dealt fire damage, it instead heals an amount of Hit Points equal to half the damage it would have taken and becomes @UUID[Compendium.sf2e.conditions.Item.Quickened] until the end of its next turn. It can use its extra action to Stride or Strike. Conversely, when a mannoq beast takes cold damage, it becomes @UUID[Compendium.sf2e.conditions.Item.Slowed]{Slowed 1} for 1 round.</p>"
                },
                "publication": {
                    "license": "OGL",
