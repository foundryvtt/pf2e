        {
            "_id": "Uo1SiUQtSoOdbmem",
            "img": "systems/sf2e/icons/actions/Passive.webp",
            "name": "Graveknight's Curse",
            "sort": 1400000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "offensive",
                "description": {
                    "value": "<p>This curse affects anyone who wears a techno graveknight's armor for at least 1 hour, unless the curse is removed</p>\n<p><strong>Saving Throw</strong> @Check[will|dc:29] save</p>\n<p><strong>Onset</strong> 1 hour</p>\n<p><strong>Stage 1</strong> @UUID[Compendium.sf2e.conditions.Item.Doomed]{Doomed 1} and can't remove armor (1 day)</p>\n<p><strong>Stage 2</strong> @UUID[Compendium.sf2e.conditions.Item.Doomed]{Doomed 2}, –10-foot status penalty to Speeds, and can't remove armor (1 day)</p>\n<p><strong>Stage 3</strong> dies and transforms into the armor's graveknight.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
