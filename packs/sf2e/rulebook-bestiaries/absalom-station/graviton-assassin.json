                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Frequency</strong> once per 10 minutes</p><hr /><p><strong>Effect</strong> The assassin emulates a black hole, selecting any number of creatures within 30 feet. Each chosen creature takes @Damage[9d8[bludgeoning]] damage and must attempt a @Check[fortitude|dc:30] save.</p><hr /><p><strong>Critical Success</strong> The creature is unaffected.</p>\n<p><strong>Success</strong> The creature takes half damage and is pulled 5 feet towards the assassin.</p>\n<p><strong>Failure</strong> The creature takes full damage, is pulled 15 feet towards the assassin, and is @UUID[Compendium.sf2e.conditions.Item.Off-Guard] against the next melee attack the assassin makes before the end of the assassin's turn.</p>\n<p><strong>Critical Failure</strong> The creature takes double damage, is pulled 30 feet towards the assassin, and is knocked @UUID[Compendium.sf2e.conditions.Item.Prone].</p>"
                },
                "frequency": {
