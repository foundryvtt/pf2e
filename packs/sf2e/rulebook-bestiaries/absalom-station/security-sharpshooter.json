        {
            "_id": "iP48GYlDSoWAeqqE",
            "img": "systems/sf2e/icons/actions/TwoActions.webp",
            "name": "Deploy Drone",
            "sort": 1000000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The sharpshooter doesn't have an active drone and their datapad is intact, isn't glitching, and is on their person</p><hr /><p><strong>Effect</strong> The sharpshooter prints and throws a hardlight drone to a point they can see within 30 feet. The drone is a Small creature with the construct, mindless, robot, and tech traits. It has @Damage[15[healing]] Hit Points and shares the sharpshooter's AC and saving throw modifiers. It hovers in place and can't move or act except as directed by the sharpshooter.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": []
                }
            },
            "type": "action"
        },
        {
            "_id": "7jzFcs0TzbNqWEmG",
            "img": "systems/sf2e/icons/actions/OneAction.webp",
            "name": "Dispersal Gas",
            "sort": 1100000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The sharpshooter's drone is within 60 feet</p><hr /><p><strong>Effect</strong> The drone sprays gas in a @Template[type:emanation|distance:10]. Creatures in the area must attempt a @Check[fortitude|dc:22] save. The sharpshooter can't use Dispersal Gas again for [[/gmr 1d4 #Recharge Dispersal Gas]]{1d4 rounds}.</p><hr /><p><strong>Critical Success</strong> The creature is immune to this effect for the next 24 hours.</p>\n<p><strong>Success</strong> The creature is @UUID[Compendium.sf2e.conditions.Item.Sickened]{Sickened 1}.</p>\n<p><strong>Failure</strong> The creature is sickened 1 and @UUID[Compendium.sf2e.conditions.Item.Off-Guard] for as long as it's sickened.</p>\n<p><strong>Critical Failure</strong> As failure, but the creature is @UUID[Compendium.sf2e.conditions.Item.Sickened]{Sickened 2} instead.</p>"
                },
