        {
            "_id": "cLvdwkcqpmb2vNuv",
            "img": "systems/sf2e/icons/actions/OneAction.webp",
            "name": "Hell's Hush",
            "sort": 0,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 1
                },
                "category": "offensive",
                "description": {
                    "value": "<p>A starship within 4 zones must attempt a @Check[will|dc:22] save. On a failure, all magic and technological communications on board the starship cease to function. Comm units can't send or receive data, and starships can't Hack Comms. Crew helming battle stations in different rooms can't use normal ship communications. Telepathy and other spells that allow creatures to communicate cease functioning. Creatures with innate telepathy from their ancestry or class features like group chat are temporarily blocked from psychic communication, receiving only vague emotional impressions from other creatures while within 4 zones of the hazard. A creature helming the starship's magic conduit can use Counter Magic to counteract Hell Hush (3rd rank; DC 20).</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [],
                "slug": null,
                "traits": {
                    "value": [
                        "divine",
                        "unholy"
                    ]
                }
            },
            "type": "action"
        }
