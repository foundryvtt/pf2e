                },
                "actions": {
                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p><strong>Trigger</strong> Feskagazar's turn begins and they have @Damage[25[healing]] Hit Points or less</p><hr /><p><strong>Effect</strong> Feskagazar has a custom augmentation in their body that delivers a specific injection in response to injury, rapidly altering their DNA. When it activates, Feskagazar becomes @UUID[Compendium.sf2e.conditions.Item.Quickened] for 1 minute and can use this extra action only to Stride or Strike. Additionally, their hands sprout massive biotechnological claws. The damage of their claw Strike increases to 2d10+9 slashing, but the size and shape of the claws prevents them from wielding weapons or using items.</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
                "rules": [
                    {
                        "attackModifier": 14,
                        "category": "simple",
