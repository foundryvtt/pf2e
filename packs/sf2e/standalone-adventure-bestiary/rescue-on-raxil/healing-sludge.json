                    "value": null
                },
                "category": "defensive",
                "description": {
                    "value": "<p><strong>Trigger</strong> Feskagazar would take damage from an attack that targets AC and the healing sludge senses the attacker</p><hr /><p><strong>Effect</strong> The healing sludge interposes itself between the attacker and Feskagazar. Feskagazar gains a +2 status bonus to AC. If the attack roll hits the healing sludge's AC, it takes damage from the attack; this could cause both the sludge and Feskagazar to take damage.</p>\n<p>@UUID[Compendium.sf2e.bestiary-effects.Item.Effect: Interpose]</p>"
                },
                "publication": {
                    "license": "OGL",
                    "remaster": false,
                    "title": ""
                },
