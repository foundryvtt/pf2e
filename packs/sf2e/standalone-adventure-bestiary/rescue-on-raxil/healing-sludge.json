        },
        {
            "_id": "oKxJ5MGG6kDFHJHO",
            "img": "systems/sf2e/icons/actions/TwoActions.webp",
            "name": "Restorative Graft",
            "sort": 300000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p><strong>Requirements</strong> The healing sludge is adjacent to Feskagazar</p><hr /><p><strong>Effect</strong> The sludge excretes restorative goop on Feskagazar's wounds. The sludge takes @Damage[1d8+8]damage, and Feskagazar regains the same number of Hit Points that the ooze lost. If this transfer reduces the sludge to 0 Hit Points, it is destroyed.</p>"
                },
